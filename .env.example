# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# false = connect directly and let system VPN handle Telegram access
TELEGRAM_USE_PROXY=false

# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional: explicit models for the evidence-first report pipeline.
# AI_MODEL=google/gemini-3.8-flash
# AI_VERIFIER_MODEL=openai/gpt-5.6-luna-pro
# AI_VERIFIER_MAX_TOKENS=32768
# AI_VERIFIER_FALLBACK_MODELS=qwen/qwen3.8-flash
# AI_EXTRACTION_MAX_TOKENS=16384
# AI_EXTRACTION_TIMEOUT_SECONDS=90
# AI_VERIFIER_TIMEOUT_SECONDS=75
# AI_RENDER_TIMEOUT_SECONDS=60
# AI_WEEKLY_TIMEOUT_SECONDS=120
# AI_REQUEST_TIMEOUT_SECONDS=90
# AI_FALLBACK_MODELS=google/gemini-3.7-flash

# Max messenger (optional, for Max chat monitoring)
# Аккаунты Max добавляются через веб-интерфейс
# MAX_ENABLED=true
# Версию обычно менять не нужно; параметры позволяют быстро обновить fingerprint,
# если MAX снова перестанет принимать старую версию клиента.
# MAX_APP_VERSION=26.25.0
# MAX_BUILD_NUMBER=6790

# VK app credentials (for future VK account integration)
VK_APP_ID=your_vk_app_id
VK_APP_SECRET=your_vk_app_secret
VK_SERVICE_TOKEN=your_vk_service_token

# Secret key for session encryption
SECRET_KEY=your_random_secret_key_here
